# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.sqlite3
*.log

# --- Virtual environments ---
env/
venv/
.venv/
tray_app_env/

# --- VS Code ---
.vscode/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Builds / dist ---
build/
dist/
*.spec

# Vite alternate-mode build output. `dist_cloud_readonly/` IS tracked
# because the VPS deploy reads from it; `dist_client_view/` is a per-dev
# build artifact and should be ignored.
Trustnode_edge_app/frontend/dist_client_view/

# --- Node ---
node_modules/

# --- Local diagnostics / temp artifacts ---
.tmp*
playwright-cloud.png
Trustnode_edge_app/client_page_tests/diagnostics/output/

# --- Local secrets (never pushed) ---
# .env stays per-machine and holds Supabase / cloud DB credentials, edge
# admin passwords, etc. Anything in .env.local is also ignored so
# operators can split global vs machine-specific overrides.
.env
.env.*
!.env.example
!.env.template

# TrustNode Lite per-deployment config — holds the Supabase URL + anon key.
# Each operator generates their own locally; the template lives next to it.
Trustnode_edge_app/web_cloud_readonly/lite/config.json

# --- Local Claude Code state ---
# Per-developer permissions and scheduler lockfiles — not part of the repo.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# --- Per-run diagnostic outputs ---
# Audit and diagnostic scripts can be tracked; their JSON output snapshots
# from a single run should not be.
Trustnode_edge_app/scripts/audit_historian_alignment_*.json

# The release gate writes its per-run report and a JSONL event stream here.
# events.jsonl is ~6 MB for a 4-hour run and is regenerated every time; the
# report is a snapshot of one machine at one moment. Neither belongs in history.
# ui_smoke.js writes a screenshot of the last page it walked; it is a debugging
# aid regenerated on every run, not a fixture.
ui_smoke.png
Trustnode_edge_app/viewer_final.png

Trustnode_edge_app/scripts/validation_out/
# ...but keep the DATED archive reports. Those were retained deliberately as
# evidence of a particular run; the un-suffixed ones are rewritten every gate.
!Trustnode_edge_app/scripts/validation_out/validation_report_*_2026*.txt

# --- Stray backup CSV next to electron-builder output ---
# The `dist#trustnode_backup.csv` file is junk left over by an aborted
# file move; ignore the pattern so it doesn't keep appearing in VS Code.
Trustnode_edge_app/desktop/dist#*

# --- Credential-discovery utilities are local-only ---
# Reads env vars / service files from the VPS to fish out secrets. Useful
# for one-off ops, but not appropriate for a shared repo.
Trustnode_edge_app/scripts/vps_grab_anon_key.py

# One-shot temp credential output from the user-mirror backfill script.
# Each run rewrites it; never commit to history.
Trustnode_edge_app/backfill_temp_passwords.json
