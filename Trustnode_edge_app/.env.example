# TrustNode Edge — local secrets TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to ".env" in the same directory and fill in real values.
# The real .env is .gitignore-d at the repo root and must never be committed.
#
# These keys are read by the local edge service on startup. They configure
# the cloud Postgres target the edge writes historian rows into, plus the
# control-plane portal URL.
# ----------------------------------------------------------------------------

# ---- Cloud Postgres (the database the edge writes into) -----------------
# For Supabase free-tier / IPv4-only networks use the Session Pooler:
#   Host = aws-0-<region>.pooler.supabase.com
#   Port = 6543
#   User = postgres.<PROJECTREF>  (the ".PROJECTREF" suffix is required)
# For paid-tier with IPv4 add-on, the direct host (port 5432) also works:
#   Host = db.<PROJECTREF>.supabase.co
#   Port = 5432
#   User = postgres
TRUSTNODE_CLOUD_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
TRUSTNODE_CLOUD_DB_PORT=6543
TRUSTNODE_CLOUD_DB_NAME=postgres
TRUSTNODE_CLOUD_DB_USER=postgres.PROJECTREF
TRUSTNODE_CLOUD_DB_PASSWORD=<your supabase database password>
TRUSTNODE_CLOUD_DB_SSLMODE=require
TRUSTNODE_CLOUD_DB_SCHEMA=public
TRUSTNODE_CLOUD_DB_TABLE=plc_readings

# ---- Control plane portal URL (used by edge-link / activation flows) ----
TRUSTNODE_CLOUD_API_URL=https://trustnode.lsapps.app
