{
  "name": "trustnode-edge-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run lint:undef && npm run smoke",
    "build:cloudro": "vite build --mode cloudro --outDir dist_cloud_readonly",
    "build:clientview": "vite build --mode clientview --outDir dist_client_view",
    "preview": "vite preview",
    "smoke": "node smoke_frontend.mjs",
    "lint:undef": "eslint -c eslint.undef.config.mjs --no-config-lookup src/"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^29.1.1",
    "vite": "^5.4.19",
    "vite-plugin-singlefile": "^2.0.3",
    "eslint": "^10.9.1",
    "globals": "^16.0.0"
  }
}
