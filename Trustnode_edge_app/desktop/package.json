{
  "name": "trustnode-desktop",
  "version": "0.1.0",
  "private": false,
  "description": "TrustNode Edge — industrial data collection & dashboards",
  "author": {
    "name": "TrustNode",
    "email": "support@trustnode.io"
  },
  "main": "main.js",
  "scripts": {
    "dev:ui": "npm --prefix ../frontend run dev",
    "dev:electron": "cross-env TRUSTNODE_UI_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "start": "electron .",
    "build:ui": "npm --prefix ../frontend install && npm --prefix ../frontend run build && npm --prefix ../frontend run build:clientview",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\build-backend.ps1",
    "build:prepare": "npm run build:ui && npm run build:backend",
    "dist:installer": "npm run build:prepare && electron-builder --win nsis && npm run copy:outputs",
    "dist:portable": "npm run build:prepare && electron-builder --win portable && npm run copy:outputs",
    "dist": "npm run build:prepare && electron-builder --win nsis portable && npm run copy:outputs",
    "copy:outputs": "python ../scripts/copy_build_outputs.py"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.trustnode.edge",
    "afterPack": "./afterPack.js",
    "productName": "TrustNode",
    "copyright": "Copyright © 2026 TrustNode",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "workspace_detector.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ui-source.json",
        "to": "ui-source.json"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../frontend/dist_client_view",
        "to": "frontend/dist_client_view"
      },
      {
        "from": "../backend/dist/trustnode-service",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/trustnode_logo.ico",
        "to": "trustnode_logo.ico"
      },
      {
        "from": "assets/trustnode_brand.png",
        "to": "trustnode_brand.png"
      }
    ],
    "win": {
      "executableName": "TrustNode",
      "icon": "assets/trustnode_logo.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "legalTrademarks": "TrustNode",
      "publisherName": "TrustNode",
      "fileAssociations": [],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TrustNode-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/trustnode_logo.ico",
      "uninstallerIcon": "assets/trustnode_logo.ico",
      "installerHeaderIcon": "assets/trustnode_logo.ico",
      "shortcutName": "TrustNode",
      "uninstallDisplayName": "TrustNode",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "TrustNode",
      "artifactName": "TrustNode-Setup-${version}.exe",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0"
  }
}
